# Copiar como .env (o .env.local). Nunca subir el .env al repositorio.

# URL base de la API del backend en desarrollo. En producción (Vercel) no se pone: se usa /v1
# del mismo dominio, que vercel.json reenvía al backend.
VITE_API_URL=http://localhost:3000/v1

# Client ID de Google (el mismo GOOGLE_CLIENT_ID del backend). Vacío = botón de Google deshabilitado.
VITE_GOOGLE_CLIENT_ID=
