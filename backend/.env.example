# Copiar este archivo como .env y ajustar los valores. Nunca subir el .env al repositorio.

# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Zona horaria en la que cambia el día (reto diario y racha)
APP_TIMEZONE=America/Bogota
# Proxies delante de la API, para leer la IP real del cliente: false en desarrollo,
# true (o 1) detrás de uno solo (Render), 2 detrás de Vercel → Render (producción)
TRUST_PROXY=false

# Base de datos (los mismos valores usa docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_maestro
DB_USER=football
DB_PASSWORD=football_dev
# true en bases en la nube que exigen SSL (Supabase). DB_SSL_CA (opcional): certificado de la base
# en una sola línea con \n, para verificar además el servidor.
DB_SSL=false

# Autenticación
# JWT_SECRET: mínimo 32 caracteres aleatorios. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
BCRYPT_COST=12
# strict si el navegador ve frontend y API en el mismo dominio (en producción Vercel reenvía /v1
# al backend, así que strict sirve); none solo si los llama en dominios distintos (requiere HTTPS)
COOKIE_SAMESITE=strict
# Client ID de Google Cloud Console (OAuth 2.0). Vacío = login con Google deshabilitado.
GOOGLE_CLIENT_ID=

# Noticias: clave de Currents API (https://currentsapi.services, plan gratuito de 250 peticiones/día).
# Vacía = noticias de ejemplo. NEWS_SYNC_MINUTES=0 desactiva la sincronización automática.
# Cada sincronización hace 16 peticiones (8 categorías x 2 idiomas): menos de 120 minutos supera el cupo gratuito.
NEWS_API_KEY=
NEWS_SYNC_MINUTES=120

# Correo de recuperación de contraseña con Brevo (https://www.brevo.com, plan gratuito de 300 correos/día).
# Vacía = el enlace se escribe en la consola del backend. MAIL_FROM debe ser un remitente verificado en Brevo.
MAIL_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Football Maestro
